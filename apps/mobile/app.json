{
  "expo": {
    "name": "COOPR",
    "slug": "coopr",
    "scheme": "coopr",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.coopr.mobile"
    },
    "android": {
      "package": "app.coopr.mobile"
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ]
  }
}
