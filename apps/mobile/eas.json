{
  "cli": {
    "version": ">=16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_FOUNDER_TOOLS": "1"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_FOUNDER_TOOLS": "0"
      }
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_FOUNDER_TOOLS": "0",
        "EXPO_PUBLIC_EXTRACT_URL": "https://REPLACE-WITH-EAS-HOSTING-ORIGIN.expo.app",
        "EXPO_PUBLIC_CADDIE_SECRET": "REPLACE-WITH-CADDIE-SECRET",
        "EXPO_PUBLIC_FEEDBACK_EMAIL": "REPLACE-WITH-FEEDBACK-EMAIL@example.com"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {}
    },
    "production": {
      "ios": {}
    },
    "beta": {
      "ios": {}
    }
  }
}
