{
  "expo": {
    "name": "COOPR",
    "slug": "coopr",
    "scheme": "coopr",
    "owner": "mikecoers",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0A1020",
    "icon": "./assets/brand/icon.png",
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.coopr.mobile",
      "icon": "./assets/brand/icon.png"
    },
    "android": {
      "package": "app.coopr.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#0A1020",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      }
    },
    "experiments": {
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-updates",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "COOPR listens while you hold Ask, or while hands-free is on. On this iPhone, speech is turned into text on the device and the audio is not kept.",
          "speechRecognitionPermission": "COOPR turns your question into text on this iPhone. The audio is not kept."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "COOPR uses your location while the app is open to show your distance to the green. Your position is not saved as a shot.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "COOPR reads a photo you choose so a server can extract golf numbers. The photo is not kept on the server. You review every number before it is saved.",
          "cameraPermission": "COOPR uses the camera for a photo of a screen, scorecard, or club. The photo is not kept on the server. You review every number before it is saved."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1020",
          "image": "./assets/brand/splash.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#0A1020",
            "image": "./assets/brand/splash.png"
          },
          "android": {
            "backgroundColor": "#0A1020",
            "image": "./assets/brand/splash-mark.png",
            "resizeMode": "contain",
            "imageWidth": 152,
            "dark": {
              "backgroundColor": "#0A1020",
              "image": "./assets/brand/splash-mark.png"
            }
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/998f1644-05ec-4980-a0b9-58e5703951d7"
    },
    "extra": {
      "eas": {
        "projectId": "998f1644-05ec-4980-a0b9-58e5703951d7"
      }
    }
  }
}
