# Copy to .env and fill in. All EXPO_PUBLIC_* vars are bundled into the app.
# Nothing here is required for offline core play — these enable the online layer.

# Supabase (auth + cloud sync). Create a project at https://supabase.com.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Language provider (caddie narration + Golf IQ narration). The deterministic engine
# does NOT need this — it only turns structured reasons into personality text.
# Called from a server/edge function, never with the raw key in the app.
# ANTHROPIC_API_KEY=            (server-side only; do not prefix EXPO_PUBLIC_)
